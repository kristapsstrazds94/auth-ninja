<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AuthNinja.AspNetCore</RootNamespace>
    <AssemblyName>AuthNinja.AspNetCore</AssemblyName>
    <PackageId>AuthNinja.AspNetCore</PackageId>
    <Version>0.0.0</Version>
    <Description>ASP.NET Core adapter for Auth-Ninja — same OpenAPI contract as @auth-ninja/next.</Description>
    <Authors>Auth-Ninja</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AuthNinja.AspNetCore.Tests" />
  </ItemGroup>

</Project>
