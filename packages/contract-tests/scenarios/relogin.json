{
  "id": "relogin",
  "name": "register → logout → login → session",
  "variables": {
    "email": "relogin@test.local",
    "password": "secure-password-1"
  },
  "steps": [
    {
      "name": "register",
      "method": "POST",
      "path": "/auth/register",
      "body": { "email": "$email", "password": "$password" },
      "expect": {
        "status": 201,
        "capture": { "session": "cookie" }
      }
    },
    {
      "name": "logout",
      "method": "POST",
      "path": "/auth/logout",
      "session": true,
      "expect": { "status": 204 }
    },
    {
      "name": "login",
      "method": "POST",
      "path": "/auth/login",
      "body": { "email": "$email", "password": "$password" },
      "expect": {
        "status": 200,
        "capture": { "session": "cookie" }
      }
    },
    {
      "name": "session",
      "method": "GET",
      "path": "/auth/session",
      "session": true,
      "csrf": false,
      "expect": {
        "status": 200,
        "body": { "user.email": "$email" }
      }
    }
  ]
}
