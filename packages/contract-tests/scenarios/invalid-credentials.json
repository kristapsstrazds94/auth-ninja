{
  "id": "invalid-credentials",
  "name": "login with wrong password returns generic 401",
  "variables": {
    "email": "bad-login@test.local",
    "password": "secure-password-1"
  },
  "steps": [
    {
      "name": "register",
      "method": "POST",
      "path": "/auth/register",
      "body": { "email": "$email", "password": "$password" },
      "expect": { "status": 201 }
    },
    {
      "name": "invalid login",
      "method": "POST",
      "path": "/auth/login",
      "body": { "email": "$email", "password": "wrong-password-value" },
      "expect": {
        "status": 401,
        "code": "INVALID_CREDENTIALS"
      }
    }
  ]
}
