{
  "name": "@auth-ninja/next",
  "version": "1.0.0",
  "license": "MIT",
  "description": "Next.js server adapter for Auth-Ninja",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/db/schema.d.ts",
      "import": "./dist/db/schema.js"
    }
  },
  "files": [
    "dist",
    "drizzle",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "node -e \"process.exit(0)\"",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/db-migrate.mjs",
    "prepublishOnly": "pnpm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kristapsstrazds94/auth-ninja.git",
    "directory": "packages/next"
  },
  "dependencies": {
    "@auth-ninja/core": "workspace:*",
    "@auth-ninja/protocol": "workspace:*",
    "@simplewebauthn/server": "^11.0.0",
    "drizzle-orm": "^0.38.3",
    "ioredis": "^6.0.0",
    "postgres": "^3.4.5",
    "zod": "^3.24.1"
  },
  "peerDependencies": {
    "next": "^14.0.0 || ^15.0.0"
  },
  "devDependencies": {
    "@auth-ninja/contract-tests": "workspace:*",
    "@electric-sql/pglite": "^0.2.17",
    "@types/node": "^22.10.2",
    "drizzle-kit": "^0.30.1",
    "next": "^15.1.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "access": "public"
  }
}
