{
  "name": "@auth-ninja/next",
  "version": "0.0.0",
  "description": "Next.js server adapter for Auth-Ninja",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "node -e \"process.exit(0)\"",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@auth-ninja/core": "workspace:*",
    "@auth-ninja/protocol": "workspace:*"
  },
  "peerDependencies": {
    "next": "^14.0.0 || ^15.0.0"
  },
  "devDependencies": {
    "next": "^15.1.3",
    "vitest": "^2.1.8",
    "typescript": "^5.7.2"
  },
  "publishConfig": {
    "access": "restricted"
  }
}
