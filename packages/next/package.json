{
  "name": "@auth-ninja/next",
  "version": "0.0.0",
  "license": "MIT",
  "description": "Next.js server adapter for Auth-Ninja",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/db/schema.d.ts",
      "import": "./dist/db/schema.js"
    }
  },
  "files": ["dist", "drizzle", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "node -e \"process.exit(0)\"",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@auth-ninja/core": "workspace:*",
    "@auth-ninja/protocol": "workspace:*",
    "drizzle-orm": "^0.38.3",
    "postgres": "^3.4.5",
    "zod": "^3.24.1"
  },
  "peerDependencies": {
    "next": "^14.0.0 || ^15.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "drizzle-kit": "^0.30.1",
    "next": "^15.1.3",
    "@types/node": "^22.10.2",
    "vitest": "^2.1.8",
    "typescript": "^5.7.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
