{
  "name": "@auth-ninja/cli",
  "version": "1.1.0",
  "license": "MIT",
  "description": "CLI for full-stack Auth-Ninja setup, database migrations, and config validation",
  "type": "module",
  "bin": {
    "auth-ninja": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "node -e \"process.exit(0)\"",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepublishOnly": "pnpm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kristapsstrazds94/auth-ninja.git",
    "directory": "packages/cli"
  },
  "dependencies": {
    "@auth-ninja/core": "workspace:*",
    "@auth-ninja/next": "workspace:*",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "vitest": "^2.1.8",
    "typescript": "^5.7.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
