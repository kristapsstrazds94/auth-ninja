{
  "name": "auth-ninja",
  "version": "0.0.0",
  "license": "MIT",
  "description": "CLI for scaffolding and validating Auth-Ninja in consumer projects",
  "type": "module",
  "bin": {
    "auth-ninja": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "node -e \"process.exit(0)\"",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@auth-ninja/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "vitest": "^2.1.8",
    "typescript": "^5.7.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
