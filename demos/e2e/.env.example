# Copy to .env before running E2E tests — never commit real secrets

AUTH_NINJA_SECRET=test-secret-min-32-chars-long-!!
# Your Postgres, or any placeholder — the runner falls back to Docker Compose
# (dynamic host port) when this URL is unreachable.
AUTH_NINJA_DATABASE_URL=postgresql://auth_ninja:auth_ninja@localhost:5432/auth_ninja_e2e
# E2E starts its own Next dev server; default 3001 avoids clashing with demo on 3000.
E2E_PORT=3001
