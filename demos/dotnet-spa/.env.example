# Copy to .env.local — never commit real secrets
# Vite dev server proxies /auth to the .NET API (see vite.config.ts)

# Leave unset for same-origin dev (Vite proxies /auth). Set only for split-origin deploys.
# VITE_AUTH_BASE_URL=https://your-spa.example.com

# Optional — match server session idle timeout
# VITE_AUTH_SESSION_IDLE_MINUTES=15
